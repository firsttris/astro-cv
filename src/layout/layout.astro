---
import "@fontsource-variable/inter";
import "./../mdx/mdx.css";

import { getLangFromUrl, useTranslations } from "../i18n/utils";

const t = useTranslations(Astro.url.pathname);
const lang = getLangFromUrl(Astro.url.pathname);
const SITE = "https://cv.teufel-it.de";
const canonicalUrl = new URL(Astro.url.pathname, SITE).href;

// Print page setup incl. running footer (rendered by Chromium-based browsers and the generated PDF)
const pageCss = `
  @page {
    size: A4;
    margin: 14mm 14mm 16mm;
    @bottom-left {
      content: "Tristan Teufel · ${t("business-title")}";
      font: 9px "Inter Variable", sans-serif;
      color: #71717a;
    }
    @bottom-right {
      content: "${t("page")} " counter(page) " ${t("of")} " counter(pages);
      font: 9px "Inter Variable", sans-serif;
      color: #71717a;
    }
  }
`;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={t("meta-description")} />
    <meta name="keywords" content="Softwareentwickler, Software developer, CV, Resume, Freelance, Clean Code, Test Automation, React, TypeScript, MUI, Node.js" />
    <meta property="og:title" content={`CV Tristan Teufel, ${t("business-title")}`} />
    <meta property="og:description" content={t("meta-description")} />
    <meta property="og:image" content="https://avatars.githubusercontent.com/u/1709260" />
    <meta property="og:url" content={canonicalUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="de" href={`${SITE}/de/`} />
    <link rel="alternate" hreflang="en" href={`${SITE}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />
    <title>CV Tristan Teufel, {t("business-title")}</title>
    <script is:inline>
      // Apply the stored theme before first paint to avoid a flash
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <style is:inline set:html={pageCss} />
    <slot name="head" />
  </head>
  <body>
    <slot name="top" />
    <div class="container">
      <slot />
    </div>
  </body>
</html>
<style is:global>
  :root {
    --page-bg: #ffffff;
    --text-color: #18181b;
    --muted-color: #71717a;
    --border: #e4e4e7;
    --surface: #fafafa;
    --accent: #18181b;
    --accent-strong: #000000;
    --accent-soft: #f4f4f5;
    --link-underline: #a1a1aa;
    --link-color: var(--accent);
    --link-hover: var(--accent-strong);
    --icon-bg: transparent;
    --icon-fg: currentColor;
    --success: #16a34a;
    --success-soft: #f0fdf4;
    --success-text: #166534;
  }

  /* Dark theme: follows the OS unless the visitor picked a theme explicitly */
  @media screen and (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --page-bg: #111111;
      --text-color: #e7e5e4;
      --muted-color: #a1a1aa;
      --border: #2a2a2a;
      --surface: #1a1a1a;
      --accent: #fafafa;
      --accent-strong: #ffffff;
      --accent-soft: rgba(255, 255, 255, 0.08);
      --link-underline: #52525b;
      --icon-bg: #e7e5e4;
      --icon-fg: #18181b;
      --success: #22c55e;
      --success-soft: rgba(34, 197, 94, 0.1);
      --success-text: #86efac;
      color-scheme: dark;
    }
  }

  @media screen {
    :root[data-theme="dark"] {
      --page-bg: #111111;
      --text-color: #e7e5e4;
      --muted-color: #a1a1aa;
      --border: #2a2a2a;
      --surface: #1a1a1a;
      --accent: #fafafa;
      --accent-strong: #ffffff;
      --accent-soft: rgba(255, 255, 255, 0.08);
      --link-underline: #52525b;
      --icon-bg: #e7e5e4;
      --icon-fg: #18181b;
      --success: #22c55e;
      --success-soft: rgba(34, 197, 94, 0.1);
      --success-text: #86efac;
      color-scheme: dark;
    }
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 72px;
  }

  body {
    margin: 0;
    background: var(--page-bg);
    color: var(--text-color);
    font-family: "Inter Variable", "Helvetica", "Arial", sans-serif;
    font-feature-settings: "cv11", "ss01";
    -webkit-font-smoothing: antialiased;
    transition: background-color 0.2s ease;
  }

  .container {
    max-width: 852px; /* md */
    display: flex;
    flex-direction: column;
    margin: 0 auto;
    padding: 0 16px 40px;
    gap: 28px;
  }

  .print-only {
    display: none;
  }

  @media print {
    .container {
      max-width: none;
      padding: 0;
      gap: 20px;
    }

    .screen-only {
      display: none !important;
    }

    .print-only {
      display: revert;
    }
  }

  /* Reveal animations */
  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .reveal {
    opacity: 0;
    animation: reveal 0.6s ease-out forwards;
    animation-delay: var(--delay, 0s);
  }

  @media print {
    .reveal {
      opacity: 1;
      animation: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .reveal {
      opacity: 1;
      animation: none;
    }
  }
</style>
