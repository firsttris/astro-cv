---
import { importMdx } from "../mdx/utils";
const Mdx = importMdx({ filename: "expertise", pathname: Astro.url.pathname });
---

<div class="expertise">
  <Mdx />
</div>

<style>
  .expertise {
    margin-top: 32px;
  }

  /* Starts the second page of the PDF, followed by the skills overview */
  @media print {
    .expertise {
      margin-top: 0;
      break-before: page;
    }
  }
</style>
