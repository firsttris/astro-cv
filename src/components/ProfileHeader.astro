---
import { Icon } from "astro-icon/components";
import QRCode from "qrcode";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Profile from "./../images/profil.png";
import Ghibli from "./../images/ghibli.png";
import ImageSwap from "./ImageSwap.astro";
import KeyFacts from "./KeyFacts.astro";

const t = useTranslations(Astro.url.pathname);
const onlineUrl = `https://cv.teufel-it.de/${getLangFromUrl(Astro.url.pathname)}/`;
const qrSvg = await QRCode.toString(onlineUrl, { type: "svg", margin: 0, color: { dark: "#0f172a", light: "#0000" } });

const contacts = [
  { icon: "material-symbols:mail-outline-rounded", label: "info@teufel-it.de", href: "mailto:info@teufel-it.de" },
  { icon: "material-symbols:call-outline", label: "+49 176 457 44166", href: "tel:+4917645744166" },
  { icon: "mdi:github", label: "GitHub", href: "https://github.com/firsttris" },
  { icon: "mdi:linkedin", label: "LinkedIn", href: "https://de.linkedin.com/in/tristanteufel" },
];
---

<header class="profile">
  <ImageSwap frontImage={Profile} backImage={Ghibli} altFront="Tristan Teufel" altBack="Tristan Teufel (Ghibli Style)" width={200} />
  <div class="intro">
    <h1 class="name">Tristan Teufel</h1>
    <p class="title">{t("business-title")}</p>
    <p class="degree">{t("academic-title")}</p>
    <KeyFacts />
    <ul class="contacts">
      {
        contacts.map((contact) => (
          <li>
            <a href={contact.href} target="_blank" rel="noopener">
              <Icon name={contact.icon} />
              {contact.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="download-button screen-only" href={t("pdf-file")} download>
      <Icon name="material-symbols:download-rounded" />
      {t("download-pdf")}
    </a>
  </div>
  <div class="print-only qr">
    <div class="qr-code" set:html={qrSvg} />
    <span>{t("online-version")}</span>
    <span>{onlineUrl.replace("https://", "")}</span>
  </div>
</header>

<style>
  .profile {
    display: flex;
    align-items: center;
    gap: 36px;
    margin-top: 32px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-width: 0;
  }

  .name {
    margin: 0;
    font-size: 44px;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .title {
    font-size: 18px;
    line-height: 26px;
    font-weight: 600;
    color: var(--accent);
  }

  .degree {
    margin-bottom: 8px;
    font-size: 13px;
    color: var(--muted-color);
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .contacts li {
    padding: 0;
  }

  .contacts a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--text-color);
  }

  .contacts a:hover {
    color: var(--accent);
  }

  .contacts a :global(svg) {
    font-size: 18px;
    color: var(--muted-color);
  }

  .download-button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    padding: 7px 14px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--page-bg);
    font-size: 14px;
    font-weight: 600;
    transition: background-color 0.15s ease;
  }

  .download-button:hover {
    background: var(--accent-strong);
    color: var(--page-bg);
  }

  .download-button :global(svg) {
    font-size: 18px;
  }

  .qr {
    flex-direction: column;
    align-items: center;
    gap: 2px;
    margin-left: auto;
    font-size: 9px;
    line-height: 12px;
    color: #64748b;
    white-space: nowrap;
  }

  .qr-code {
    width: 72px;
    height: 72px;
    margin-bottom: 4px;
  }

  @media (max-width: 640px) {
    .profile {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      margin-top: 20px;
    }

    .name {
      font-size: 36px;
    }
  }

  @media print {
    .profile {
      gap: 28px;
      margin-top: 0;
    }

    .name {
      font-size: 34px;
    }

    .contacts {
      gap: 4px 14px;
    }

    .contacts a {
      font-size: 12px;
    }

    .qr {
      display: flex;
    }
  }
</style>
