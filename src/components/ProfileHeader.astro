---
import styled from "@emotion/styled";
import { useTranslations } from "../i18n/utils";
import Profile from "./../images/profil.png";
import Ghibli from "./../images/ghibli.png";
import { Icon } from "astro-icon/components";
import { Typography } from "./Typography";
import ImageSwap from "./ImageSwap.astro";
import KeyFacts from "./KeyFacts.astro";
import QRCode from "qrcode";
import { getLangFromUrl } from "../i18n/utils";

const t = useTranslations(Astro.url.pathname);
const onlineUrl = `https://cv.teufel-it.de/${getLangFromUrl(Astro.url.pathname)}/`;
const qrSvg = await QRCode.toString(onlineUrl, { type: "svg", margin: 0, color: { dark: "#1e293b", light: "#0000" } });

const ContainerBox = styled.div({
  marginTop: "20px",
  display: "flex",
  "@media (max-width: 960px)": {
    flexDirection: "column",
  },
  "@media print": {
    flexDirection: "row",
  },
});

const ImageBox = styled.div({
  borderRadius: "5px",
  display: "inline-flex",
  boxShadow:
    "rgba(0, 0, 0, 0.2) 0px 2px 4px -1px, rgba(0, 0, 0, 0.14) 0px 4px 5px 0px, rgba(0, 0, 0, 0.12) 0px 1px 10px 0px",
});

const ContactBox = styled.div({
  display: "flex",
  alignItems: "center",
  gap: "5px",
});

const ContentBox = styled.div({
  display: "flex",
  flexDirection: "column",
  justifyContent: "center",
  gap: "20px",
  margin: "10px",
  width: "100%",
  "@media (max-width: 960px)": {
    marginTop: "20px",
  },
});

const Grid = styled.div({
  display: "flex",
  gap: "15px",
  margin: "0 auto",
});

const Column = styled.div({
  display: "flex",
  flexDirection: "column",
  gap: "5px",
});

const Link = styled.a({
  textDecoration: "none",
  color: "#2563eb",
  transition: "color 0.15s ease",
  "&:hover": {
    color: "#1d4ed8",
  },
});
---

<ContainerBox>
  <div style={{ display: "flex", justifyContent: "center" }}>
    <ImageSwap
    frontImage={Ghibli}
    backImage={Profile}
    altFront="Ghibli Style"
    altBack="Real Image"
    width={240}
  />
  </div>
  <ContentBox>
    <div
      style={{ textAlign: "center", display: "flex", flexDirection: "column" }}
    >
      <Typography className="display">Tristan Teufel</Typography>
      <Typography className="subtitle">
        {t("business-title")}
      </Typography>
      <Typography className="caption">
        {t("academic-title")}
      </Typography>
    </div>
    <div class="facts-row"><KeyFacts /></div>
    <Grid>
      <Column>
        <ContactBox>
          <Icon name="openmoji:envelope" font-size={25} />
          <Link href="mailto:info@teufel-it.de" rel="noopener" target="_blank">
            <Typography className="body">info@teufel-it.de</Typography>
          </Link>
        </ContactBox>
        <ContactBox>
          <Icon name="openmoji:mobile-phone" font-size={25} />
          <Link href="tel:+49 176 457 44166" rel="noopener" target="_blank">
            <Typography className="body">+49 176 457 44166</Typography>
          </Link>
        </ContactBox>
      </Column>
      <Column>
        <ContactBox>
          <Icon name="openmoji:github" font-size={25} />
          <Link
            href="https://github.com/firsttris"
            rel="noopener"
            target="_blank"
          >
            <Typography className="body">GitHub</Typography>
          </Link>
        </ContactBox>
        <ContactBox>
          <Icon name="openmoji:linkedin" font-size={25} />
          <Link
            href="https://de.linkedin.com/in/tristanteufel"
            rel="noopener"
            target="_blank"
          >
            <Typography className="body">LinkedIn</Typography>
          </Link>
        </ContactBox>
      </Column>
    </Grid>
    <div class="screen-only download">
      <a class="download-button" href={t("pdf-file")} download>
        <Icon name="material-symbols:download-rounded" font-size={18} />
        {t("download-pdf")}
      </a>
    </div>
  </ContentBox>
  <div class="print-only qr">
    <div class="qr-code" set:html={qrSvg} />
    <span>{t("online-version")}</span>
    <span>{onlineUrl.replace("https://", "")}</span>
  </div>
</ContainerBox>

<style>
  .facts-row {
    display: flex;
    justify-content: center;
  }

  .download {
    display: flex;
    justify-content: center;
  }

  .download-button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    font-size: 14px;
    font-weight: 500;
    color: #1e293b;
    background: #f8fafc;
  }

  .download-button:hover {
    background: #f1f5f9;
    color: #1e293b;
  }

  .qr {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-width: 110px;
    font-size: 9px;
    line-height: 12px;
    color: #64748b;
  }

  @media print {
    .qr {
      display: flex;
    }
  }

  .qr-code {
    width: 76px;
    height: 76px;
    margin-bottom: 4px;
  }
</style>
