---
import { useTranslations } from "../i18n/utils";
import { AVAILABLE_FROM, CAREER_START_YEAR } from "../profile";

const t = useTranslations(Astro.url.pathname);

const years = new Date().getFullYear() - CAREER_START_YEAR;
const facts = [
  `${years}+ ${t("years-experience")}`,
  t("fact-installs"),
  t("fact-work-mode"),
];
---

<ul class="facts">
  {AVAILABLE_FROM && <li class="available">{t("available-from")} {AVAILABLE_FROM}</li>}
  {facts.map((fact) => <li>{fact}</li>)}
</ul>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: 12px;
    line-height: 18px;
    font-weight: 500;
    color: var(--text-color);
  }

  .facts li.available {
    border-color: #16a34a;
    background: #f0fdf4;
    color: #166534;
  }

  .facts li.available::before {
    content: "";
    width: 6px;
    height: 6px;
    margin-right: 6px;
    border-radius: 50%;
    background: #16a34a;
  }
</style>
