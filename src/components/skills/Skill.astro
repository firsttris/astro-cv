---
import ChipsWithIcon from "./ChipsWithIcon.astro";
import { type Skill } from "./technologies";

interface Props {
  title: string;
  skills: Skill[];
}

const { title, skills } = Astro.props;
---

<div class="skill">
  <div class="title-box">
    <p class="label">{title}</p>
  </div>
  <div class="skills-box">
    <ChipsWithIcon skills={skills} showLevel />
  </div>
</div>

<style>
  .skill {
    display: flex;
    margin-bottom: 12px;
  }

  .title-box {
    min-width: 110px;
    padding-top: 5px;
  }

  .skills-box {
    flex: 1;
  }

  .label {
    margin: 0;
    padding: 0;
    font-family: inherit;
    font-size: 11px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--muted-color);
  }

  @media (max-width: 425px) {
    .title-box {
      display: none;
    }
  }

  @media print {
    .skill {
      break-inside: avoid;
    }
  }
</style>
