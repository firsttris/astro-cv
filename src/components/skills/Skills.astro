---
import { useTranslations } from "../../i18n/utils";
import Skill from "./Skill.astro";
import { mySkills } from "./mySkills";
import { type LocaType } from "../../i18n/utils";
import SkillLegend from "./SkillLegend.astro";

const t = useTranslations(Astro.url.pathname);
---

<div class="skills-section">
  <div class="skills-header">
    <p class="title">{t("skills")}</p>
  </div>
  
  {
    mySkills.map((skill) => (
      <Skill title={t(skill.title as LocaType)} skills={skill.skills} />
    ))
  }
  <SkillLegend />
</div>

<style>
  .skills-header {
    margin-bottom: 16px;
  }

  .title {
    margin: 0;
    padding: 0;
    font-family: inherit;
    font-size: 24px;
    line-height: 32px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-color);
  }

  @media print {
    .skills-header {
      break-after: avoid;
    }

    /* Keep the whole skills overview on one page */
    .skills-section {
      break-inside: avoid;
    }
  }
</style>
