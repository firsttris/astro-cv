---
import { Icon } from "astro-icon/components";
import { Level, type Skill } from "./technologies";
import { coreSkills } from "./mySkills";
import { useTranslations } from "../../i18n/utils";
import LevelDots from "./LevelDots.astro";

interface Props {
  skills: Skill[];
  /** Show the skill level and highlight core skills (skills overview) */
  showLevel?: boolean;
  /** Render a compact comma-separated text line instead of chips when printing */
  printAsText?: boolean;
}

const { skills, showLevel = false, printAsText = false } = Astro.props;

const t = useTranslations(Astro.url.pathname);
---

<div class:list={["chips", { "screen-only": printAsText }]}>
  {
    skills.map((skill) => {
      const isCore = showLevel && coreSkills.includes(skill);
      return (
        <a
          class:list={["chip", { core: isCore }]}
          href={skill.website}
          target="_blank"
          rel="noopener"
          title={showLevel ? `${skill.name}: ${t(skill.level)}` : skill.name}
        >
          <Icon class="chip-icon" name={skill.icon} />
          <span class="chip-name">{skill.name}</span>
          {showLevel && <LevelDots level={skill.level as Level} />}
        </a>
      );
    })
  }
</div>
{printAsText && <p class="skills-text">{skills.map((skill) => skill.name).join(" · ")}</p>}

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding: 0 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text-color);
    font-size: 13px;
    font-weight: 500;
    line-height: 20px;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .chip:hover {
    color: var(--text-color);
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .chip.core {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .chip-icon {
    font-size: 18px;
    flex-shrink: 0;
  }

  .skills-text {
    display: none;
  }

  @media print {
    .chip {
      height: 22px;
      padding: 0 8px;
      font-size: 11px;
    }

    .chip-icon {
      font-size: 14px;
    }

    .screen-only {
      display: none;
    }

    .skills-text {
      display: block;
      margin-top: 4px;
      font-size: 11px;
      line-height: 16px;
      color: var(--muted-color);
      break-inside: avoid;
    }
  }
</style>
