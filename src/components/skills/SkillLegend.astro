---
import { useTranslations } from "../../i18n/utils";
import { Level } from "./technologies";
import LevelDots from "./LevelDots.astro";

const t = useTranslations(Astro.url.pathname);
---

<div class="legend">
  <span class="item"><span class="core-sample" />{t("core-skill")}</span>
  <span class="item"><LevelDots level={Level.Expert} />{t("expert")}</span>
  <span class="item"><LevelDots level={Level.Intermediate} />{t("intermediate")}</span>
  <span class="item"><LevelDots level={Level.Beginner} />{t("beginner")}</span>
</div>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px 20px;
    margin-top: 20px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    line-height: 18px;
    color: var(--muted-color);
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .core-sample {
    width: 18px;
    height: 12px;
    border: 1px solid var(--accent);
    border-radius: 4px;
    background: var(--accent-soft);
  }

  @media print {
    .legend {
      break-inside: avoid;
      break-before: avoid;
    }
  }
</style>
