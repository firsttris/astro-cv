---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  frontImage: ImageMetadata;
  backImage: ImageMetadata;
  altFront: string;
  altBack: string;
  width: number;
}

// Shows the front image and reveals the back image on hover/focus (screen only).
const { frontImage, backImage, altFront, altBack, width } = Astro.props;
---

<div class="image-swap" style={{ width: `${width}px`, height: `${width}px` }} tabindex="0">
  <Image class="front" src={frontImage} alt={altFront} width={width * 2} height={width * 2} loading="eager" />
  <Image class="back screen-only" src={backImage} alt={altBack} width={width * 2} height={width * 2} />
</div>

<style>
  .image-swap {
    position: relative;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid var(--border);
    box-shadow: 0 12px 24px -12px rgba(15, 23, 42, 0.35);
    outline: none;
  }

  .image-swap img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      opacity 500ms ease,
      transform 500ms ease;
  }

  .back {
    opacity: 0;
  }

  .image-swap:hover .front,
  .image-swap:focus-visible .front {
    opacity: 0;
    transform: scale(1.05);
  }

  .image-swap:hover .back,
  .image-swap:focus-visible .back {
    opacity: 1;
    transform: scale(1.05);
  }

  @media print {
    .image-swap {
      width: 150px !important;
      height: 150px !important;
      box-shadow: none;
      border-radius: 14px;
    }
  }
</style>
