// Renovate (GitHub App, https://github.com/apps/renovate): a pull request for each new release of
// what the CV builds on, plus the "Dependency Dashboard" issue listing what is open. Their own pull
// requests: Astro with its integrations (MDX, astro-icon), Playwright that renders the PDFs, and
// Bun (packageManager in package.json: the Bun of the workflows, which runs Astro and the PDFs).
// Everything else (the other packages, the actions, the images) comes with the shared settings of
// firsttris/workflows (renovate/default.json5): minor and patch updates once a month in one pull
// request that merges itself when CI is green, majors on request in the dashboard.
// Check with `bunx --package renovate renovate-config-validator .github/renovate.json5`.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>firsttris/workflows//renovate/default.json5"],
  // Its pull requests run no CI, so nothing merges itself
  automerge: false,
  lockFileMaintenance: { automerge: false },
  customManagers: [
    {
      // "Astro 7" in the README (a major only)
      customType: "regex",
      managerFilePatterns: ["/^README\\.md$/"],
      matchStrings: ["Built with Astro (?<currentValue>\\d+),"],
      depNameTemplate: "astro-readme",
      packageNameTemplate: "astro",
      datasourceTemplate: "npm",
      extractVersionTemplate: "^(?<version>\\d+)\\.\\d+\\.\\d+$",
      versioningTemplate: "regex:^(?<major>\\d+)$",
    },
  ],
  packageRules: [
    {
      // Astro and its integrations in one PR: a new Astro major usually needs new majors of them
      matchPackageNames: ["astro", "@astrojs/**", "astro-icon"],
      enabled: true,
      groupName: "Astro",
      sourceUrl: "https://github.com/withastro/astro",
      prBodyNotes: [
        "Before merging: read the Astro upgrade guide for a new major (https://docs.astro.build/en/upgrade-astro/), its Bun notes included (Bun runs Astro: `bun --bun astro`). The Check Build run of this PR builds the site and the PDFs; locally `bun run build` and check the PDFs as CLAUDE.md says: 9 pages, page 1 with the summary, open-source development and own products, page 2 with technical expertise and skills.",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      // Renders dist/ to the two PDFs (scripts/generate-pdf.mjs)
      matchPackageNames: ["playwright"],
      enabled: true,
      groupName: "Playwright",
      sourceUrl: "https://github.com/microsoft/playwright",
      prBodyNotes: [
        "A new Chromium can break pages differently. Before merging: `bun run build` and check both PDFs as CLAUDE.md says (9 pages, page 1 and page 2 as before).",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
    {
      // packageManager in package.json (Renovate reads it as the dependency `bun`): the Bun of both
      // workflows (setup-bun's bun-version-file), which installs from bun.lock, runs Astro
      // (`bun --bun astro build`) and the PDF script with Playwright
      matchPackageNames: ["bun"],
      groupName: "Bun",
      sourceUrl: "https://github.com/oven-sh/bun",
      prBodyNotes: [
        "`packageManager` in package.json is the Bun of the Check Build and Deploy workflows (`bun-version-file` of setup-bun). Bun installs the packages (`bun.lock`), runs Astro (`bun --bun astro build`) and `scripts/generate-pdf.mjs` with Playwright. The Check Build run of this PR builds the site and the PDFs; locally `bun install && bun run build` and check both PDFs as CLAUDE.md says (9 pages, page 1 and page 2 as before).",
      ],
      schedule: ["at any time"],
      automerge: false,
      dependencyDashboardApproval: false,
    },
  ],
}
